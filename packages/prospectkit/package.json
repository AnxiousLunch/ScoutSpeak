{
  "name": "prospectkit",
  "version": "0.1.0",
  "description": "Pure lead enrichment logic for B2B prospecting: citation-aware schemas, fit scoring, and research status.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "example": "tsx examples/basic.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "prospecting",
    "lead enrichment",
    "b2b",
    "ai",
    "citations"
  ],
  "author": "Muhammad Umer Safee and [TEAMMATE NAMES]",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
