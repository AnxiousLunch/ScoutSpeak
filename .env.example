# Supabase project URL and anonymous/public key.
# These values are safe to expose in the browser and are used by both the
# server and the client. Fill them in from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The same values without the NEXT_PUBLIC_ prefix are sometimes used by
# server-only Supabase clients. They are optional if the public variables above
# are set.
SUPABASE_URL=
SUPABASE_ANON_KEY=
