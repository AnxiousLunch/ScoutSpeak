# Supabase (public, safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server fallback (optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase service-role key (server only; used ONLY by src/lib/supabase/admin.ts for /api/join)
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (server only)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=

# Postgres (server only, used by direct Postgres clients)
DATABASE_URL=

# Session secret (server only)
SESSION_SECRET=

# Optional: enable the temporary /api/ai/ping smoke route
AI_PING_ENABLED=false
